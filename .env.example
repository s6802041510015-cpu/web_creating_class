# Public URL of the separate Vercel API project (without /api/chat).
# The Gemini key belongs only in Vercel's GEMINI_API_KEY environment variable.
VITE_AI_API_URL=https://your-ai-project.vercel.app
# Public LIFF ID from the WebQuest LINE Login channel.
# Leave it unset in .env.local when using localhost demo mode.
VITE_LIFF_ID=2012268768-BPIlGmOb

# Set to true only after the Vercel API has Google Sheets credentials.
VITE_PROGRESS_SYNC_ENABLED=false
