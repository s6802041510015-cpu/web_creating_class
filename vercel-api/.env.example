# Public Channel ID of the LINE Login channel used by the LIFF app.
LINE_CHANNEL_ID=2012268768

# Optional: only needed for the AI chat endpoint.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Existing Sheet access; keep the JSON secret only on the API server.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Single teacher account. Generate the hash and session key with npm run teacher:credentials.
TEACHER_USERNAME=
TEACHER_PASSWORD_HASH=
TEACHER_SESSION_SECRET=
